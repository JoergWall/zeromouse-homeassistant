{
  "config": {
    "step": {
      "user": {
        "title": "ZeroMOUSE",
        "description": "Sign in with your ZeroMOUSE app account. This unofficial integration stores the credentials in Home Assistant to renew the cloud session.",
        "data": {
          "email": "Email",
          "password": "Password"
        },
        "data_description": {
          "email": "The email address you use to sign in to the ZeroMOUSE app.",
          "password": "The password of your ZeroMOUSE app account."
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "Enter the current password for {email}.",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "The password of your ZeroMOUSE app account."
        }
      },
      "reconfigure": {
        "title": "Change ZeroMOUSE account",
        "description": "Change the email address or password. It has to be the same ZeroMOUSE account.",
        "data": {
          "email": "Email",
          "password": "Password"
        },
        "data_description": {
          "email": "The email address you use to sign in to the ZeroMOUSE app.",
          "password": "The password of your ZeroMOUSE app account."
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid email or password",
      "cannot_connect": "Cannot connect to the ZeroMOUSE cloud",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "Account is already configured",
      "reauth_successful": "Re-authentication was successful",
      "unique_id_mismatch": "The credentials belong to a different ZeroMOUSE account",
      "reconfigure_successful": "Re-configuration was successful"
    }
  },
